# Copy to .env in the repository root; chmod 600 .env.
# Domain only: no scheme, port, or path. DNS must point to this VPS.
P60_DOMAIN=predict60.example.com
P60_IMAGE_TAG=local
PREDICT60_LOG_LEVEL=normal
# Optional server-side provider keys; Oil remains disabled.
# OILPRICE_API_KEY=
# TWELVE_DATA_API_KEY=

# Optional direct sponsor: HTTPS URL, plain text. No tracking scripts.
# P60_SPONSOR_NAME=
# P60_SPONSOR_URL=
# P60_SPONSOR_MESSAGE=

# Maximum simultaneous app HTTP handlers (1–256). Excess requests receive 503.
P60_MAX_REQUESTS=32

# Set the private signup code here. Missing/empty disables signup, not login.
P60_SIGNUP_CODE=
