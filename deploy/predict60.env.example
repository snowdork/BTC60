# Install as /etc/predict60/predict60.env with root:predict60 ownership and mode 0640.
P60_HOST=https://predict60.com
P60_SECURE_COOKIES=true
P60_TRUSTED_PROXIES=127.0.0.1,::1
PREDICT60_DB=/var/lib/predict60/btc60.sqlite3

# Add only the provider credentials actually used. Never commit their values.
# TWELVE_DATA_API_KEY=
# OILPRICE_API_KEY=
