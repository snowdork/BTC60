# Copy to .env.local in the project root. Used by local Compose and restart-docker.sh --local.
# Used only when SIGNUP_CODE_REQUIRED is enabled in src/backend/CONST.py.
P60_SIGNUP_CODE=

# Used by browser buttons and backend verification; no client secret is needed.
# Authorize http://localhost and http://localhost:<P60_PORT> in Google Cloud.
GOOGLE_CLIENT_ID=572697973282-e17b6uqatr36toqi48sohg6vigkarvai.apps.googleusercontent.com

# Published Docker port on loopback. Use a different port when the VPS stack also runs here.
P60_PORT=8085
