predict60.com, predict60.free-vibe.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://accounts.google.com/gsi/ https://api.exchange.coinbase.com wss://ws-feed.exchange.coinbase.com; form-action 'self'; frame-ancestors 'none'; frame-src https://accounts.google.com/gsi/; img-src 'self' data:; object-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	reverse_proxy 127.0.0.1:{$P60_PORT:8085} {
		# Send one canonical address; the app trusts this only from loopback.
		header_up X-Forwarded-For {remote_host}
		health_uri /healthz
		health_interval 30s
		health_timeout 5s
	}
}
