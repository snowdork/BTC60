[Unit]
Description=Back up the Predict60 SQLite database

[Service]
Type=oneshot
User=predict60
Group=predict60
WorkingDirectory=/opt/predict60/current
EnvironmentFile=/etc/predict60/predict60.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/predict60/current/scripts/database.py backup --backup-dir /var/backups/predict60
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/predict60
ReadWritePaths=/var/backups/predict60
