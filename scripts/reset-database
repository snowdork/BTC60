#!/usr/bin/env python3
"""Back up and reset a stopped Predict60 database, clearing account and prediction data."""
import argparse
from pathlib import Path
import sys

from database import main


def reset_database():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--db', type=Path,
                        help='SQLite path (default: PREDICT60_DB or checkout database)')
    parser.add_argument('--confirm-reset', action='store_true',
                        help='Required: back up existing data, then reset')
    args = parser.parse_args()
    sys.argv = [sys.argv[0], 'reset']
    if args.db is not None:
        sys.argv.extend(['--db', str(args.db)])
    if args.confirm_reset:
        sys.argv.append('--confirm-reset')
    return main()


if __name__ == '__main__':
    sys.exit(reset_database())
