# Copy to .env in the repository root; chmod 600 .env.
# Domain only: no scheme, port, or path. DNS must point to this VPS.
P60_DOMAIN=predict60.com
P60_ADDITIONAL_ORIGINS=https://predict60.free-vibe.com
# Private host port used by the shared VPS reverse proxy.
P60_PORT=8085
P60_IMAGE_TAG=local
PREDICT60_LOG_LEVEL=normal
# Optional server-side provider keys; Oil remains disabled.
# OILPRICE_API_KEY=
# TWELVE_DATA_API_KEY=

# Optional direct sponsor: HTTPS URL, plain text. No tracking scripts.
# P60_SPONSOR_NAME=
# P60_SPONSOR_URL=
# P60_SPONSOR_MESSAGE=

# Maximum simultaneous app HTTP handlers (1–256). Excess requests receive 503.
P60_MAX_REQUESTS=32

# Set the private signup code here. Missing/empty disables signup, not login.
P60_SIGNUP_CODE=

# Public Google Identity Services web client ID; no client secret is needed.
GOOGLE_CLIENT_ID=572697973282-e17b6uqatr36toqi48sohg6vigkarvai.apps.googleusercontent.com
